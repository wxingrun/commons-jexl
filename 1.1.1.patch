+    private void addWildcard(final String wildcard) {
+        final String packageName = wildcardPackage(wildcard);
+        final boolean covered = hasWildcardAncestor(packageName);
+        final Set<String> redundantWildcards = new LinkedHashSet<>();
+        for (final String current : wildcards) {
+            if (containsPackage(packageName, wildcardPackage(current))) {
+                redundantWildcards.add(current);
+            }
+        }
+        wildcards.removeAll(redundantWildcards);
+        final Set<String> redundantPackages = new LinkedHashSet<>();
+        for (final String current : packages.keySet()) {
