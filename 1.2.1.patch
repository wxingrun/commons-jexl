     protected Number narrowBigInteger(final Object lhs, final Object rhs, final BigInteger big) {
+        if (lhs instanceof BigInteger || rhs instanceof BigInteger) {
+            return big;
+        }
         return narrowToLong(lhs, rhs, big, BigInteger::longValueExact);
