+    @Test
+    void testMergeRulesInclusion() {
+        // "java.util.*" includes "java.util.concurrent.*"
+        JexlPermissions p = JexlPermissions.parse().compose("java.util.*", "java.util.concurrent.*");
+        assertTrue(p.allow(java.util.Map.class));
